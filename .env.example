# Use your Neon connection string for both local dev and production
# Get it from: https://console.neon.tech → Connection Details → Connection string
DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require

# For migrations (use the non-pooled/direct URL from Neon dashboard)
DATABASE_URL_UNPOOLED=postgresql://user:pass@ep-xxx.region.aws.neon.tech/dbname?sslmode=require

BETTER_AUTH_SECRET=change-me-generate-with-openssl-rand-base64-32
NUXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000

# Google OAuth (from Google Cloud Console > APIs & Services > Credentials)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

GOOGLE_GENERATIVE_AI_API_KEY=your-gemini-api-key
NUXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key
# Server-side Maps API key (IP-restricted, no referer restriction)
# Falls back to NUXT_PUBLIC_GOOGLE_MAPS_API_KEY if not set
NUXT_PRIVATE_GOOGLE_MAPS_API_KEY=your-server-google-maps-api-key

# Resend (for invite emails)
RESEND_API_KEY=re_xxxxx
RESEND_FROM_EMAIL=AI Trip <noreply@yourdomain.com>

# AeroDataBox API (via RapidAPI) — free tier: ~600 calls/month
AERODATABOX_API_KEY=

# Encryption key for sensitive data (passport numbers). Generate with: openssl rand -base64 32
ENCRYPTION_KEY=
