{
  "name": "ai-trip",
  "private": true,
  "license": "MIT",
  "author": "Teoh Jia Jing",
  "type": "module",
  "imports": {
    "#shared/*": "./shared/*.ts"
  },
  "scripts": {
    "build": "nuxt build",
    "vercel-build": "nuxt build && if [ \"$VERCEL_ENV\" = production ]; then drizzle-kit migrate; else echo \"Skipping drizzle-kit migrate (VERCEL_ENV=${VERCEL_ENV:-unset}, not production)\"; fi",
    "dev": "nuxt dev --host",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "auth:gen": "bun x auth generate --config ./server/lib/auth.ts --output ./server/db/schema/auth-schema.ts -y",
    "db:gen": "bun run auth:gen && drizzle-kit generate",
    "db:push": "bun run auth:gen && drizzle-kit push",
    "db:migrate": "drizzle-kit migrate",
    "db:re-encrypt": "tsx server/db/re-encrypt-data.ts",
    "db:backfill-stays": "tsx server/db/backfill-stays.ts",
    "db:seed-test": "tsx server/db/seed-test-data.ts",
    "docker:dev": "docker compose -f docker/docker-compose.dev.yml up -d",
    "pwa:assets": "pwa-assets-generator",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt --write .",
    "fmt:check": "oxfmt --check .",
    "fix": "oxlint --fix && oxfmt --write .",
    "check": "oxfmt --check . && oxlint",
    "prepare": "husky"
  },
  "dependencies": {
    "@ai-sdk/deepseek": "^3.0.44",
    "@ai-sdk/google": "^4.0.69",
    "@better-auth/infra": "^0.4.9",
    "@better-auth/mcp": "^1.7.4",
    "@googlemaps/js-api-loader": "^2.1.1",
    "@googlemaps/markerclusterer": "^2.6.2",
    "@modelcontextprotocol/server": "^2.0.0",
    "@neondatabase/serverless": "^1.1.0",
    "@nuxt/icon": "2.5.1",
    "@nuxt/image": "2.1.0",
    "@nuxtjs/seo": "5.3.16",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.3.3",
    "@tresjs/cientos": "^5.8.1",
    "@tresjs/nuxt": "^5.6.3",
    "@upstash/redis": "^1.38.4",
    "@vercel/analytics": "^2.0.1",
    "@vite-pwa/nuxt": "^1.1.1",
    "ai": "^7.0.99",
    "better-auth": "^1.7.4",
    "d3-geo": "^3.1.1",
    "dayjs-nuxt": "^2.1.11",
    "dompurify": "^3.4.15",
    "drizzle-orm": "^0.45.2",
    "marked": "^18.0.13",
    "nuxt": "^4.5.2",
    "nuxt-security": "^2.6.0",
    "pg": "^8.23.0",
    "resend": "^6.28.0",
    "satori": "^0.33.4",
    "tailwindcss": "^4.3.3",
    "topojson-client": "^3.1.0",
    "vue": "^3.5.42",
    "vue-border-beam": "^0.1.1",
    "vue-draggable-plus": "0.6.1",
    "vue-router": "^5.3.1",
    "ws": "^8.21.3",
    "zod": "^4.6.4"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.132",
    "@types/d3-geo": "^3.1.1",
    "@types/dompurify": "^3.2.0",
    "@types/google.maps": "^3.66.2",
    "@types/pg": "^8.23.1",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "@types/ws": "^8.18.1",
    "@vite-pwa/assets-generator": "^2.0.0",
    "drizzle-kit": "^0.31.10",
    "husky": "^9.1.7",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "playwright": "^1.63.0",
    "vue-tsc": "^3.3.11"
  },
  "overrides": {
    "@better-auth/utils": "0.4.2",
    "samlify>camelcase": "6.3.0",
    "sharp": "0.34.5"
  }
}
